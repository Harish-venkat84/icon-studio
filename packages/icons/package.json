{
  "name": "@icon-studio/icons",
  "version": "0.1.0",
  "description": "SVG icons and PNG images as tree-shakable React and React Native components, generated by Icon Studio",
  "keywords": [
    "icons",
    "svg",
    "react",
    "react-native",
    "nextjs",
    "components"
  ],
  "license": "MIT",
  "author": "Harish (https://github.com/Harish-venkat84)",
  "homepage": "https://github.com/Harish-venkat84/icon-studio#readme",
  "bugs": {
    "url": "https://github.com/Harish-venkat84/icon-studio/issues"
  },
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harish-venkat84/icon-studio.git",
    "directory": "packages/icons"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/native.d.ts",
        "default": "./dist/native.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dynamic": {
      "react-native": {
        "types": "./dist/native.d.ts",
        "default": "./dist/native.js"
      },
      "types": "./dist/dynamic.d.ts",
      "default": "./dist/dynamic.js"
    },
    "./images": {
      "react-native": {
        "types": "./dist/native-images.d.ts",
        "default": "./dist/native-images.js"
      },
      "types": "./dist/images.d.ts",
      "default": "./dist/images.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    },
    "./native-images": {
      "types": "./dist/native-images.d.ts",
      "default": "./dist/native-images.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    }
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "build": "pnpm generate && rm -rf dist && tsc -p tsconfig.build.json && cp -r src/generated/png dist/generated/",
    "typecheck": "pnpm generate && tsc --noEmit -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native-svg": ">=15.0.0"
  },
  "devDependencies": {
    "@icon-studio/core": "workspace:*",
    "@types/node": "^24",
    "@types/react": "^19",
    "react": "19.2.4",
    "react-native-svg": "^15.15.5",
    "tsx": "^4.20.0",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    }
  }
}
