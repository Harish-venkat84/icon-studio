# Basic-auth users for the studio, as user:password pairs separated by commas.
# Required in production; in development the studio is open when this is empty.
STUDIO_USERS=

# Where icons are stored: "fs" writes to this checkout (local development),
# "github" commits to the repository through the GitHub API (server).
ICONS_STORAGE=fs

# fs storage: path to the icon-studio repository root (defaults to ../.. from apps/studio)
ICONS_REPO_DIR=

# github storage: a fine-grained token with Contents read/write on the repository.
# (GitHub reserves the GITHUB_ prefix for its own variables, hence the ICONS_ prefix.)
ICONS_GITHUB_TOKEN=
ICONS_GITHUB_REPOSITORY=your-github-user/icon-studio
ICONS_GITHUB_BRANCH=main

# Public host names the studio is served from behind a reverse proxy, comma separated
# (e.g. icons.example.com). Needed when the proxy's Host differs from the app's.
STUDIO_ALLOWED_ORIGINS=
